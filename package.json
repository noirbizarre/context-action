{
  "name": "context-action",
  "version": "1.0.0",
  "private": true,
  "description": "Normalize and validate complex GitHub Action context with JSON Schema",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.26.0"
}
